paste(round(transition_matrix_worse, 4))
####################################
# EXTRACT TRANSITION PROBABILITIES #
####################################
hmm_gene_rankings_desc <- arrange(hmm_result, desc(r_squared))
best_gene_hmm <- slice(hmm_gene_rankings_desc, 1)
best_gene_hmm <- pull(best_gene_hmm, gene_id_entrez)
worse_gene_hmm <- slice(hmm_gene_rankings_desc, 300)
worse_gene_hmm <- pull(worse_gene_hmm, gene_id_entrez)
best_hmm <- all_hmm_models[[as.character(best_gene_hmm)]]
worse_hmm <- all_hmm_models[[as.character(worse_gene_hmm)]]
# can change best_hmm and worse_hmm as desired
transition_matrix_best <- matrix(nrow = 3, ncol = 3)
for(i in 1:3) {
transition_matrix_best[i, ] <- getpars(getmodel(best_hmm, "transition", i))
}
transition_matrix_worse <- matrix(nrow = 3, ncol = 3)
for(i in 1:3) {
transition_matrix_worse[i, ] <- getpars(getmodel(worse_hmm, "transition", i))
}
paste0("transition probability matrix for best gene:")
paste(round(transition_matrix_best, 4))
paste0("transition probability matrix for worse gene (300th place):")
paste(round(transition_matrix_worse, 4))
